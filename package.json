{
  "name": "thai-3d-ai-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "cf:deploy": "npm run build && rm -rf .cloudflare-assets && mkdir -p .cloudflare-assets/_next && cp .next/server/app/index.html .cloudflare-assets/index.html && cp .next/server/app/_not-found.html .cloudflare-assets/404.html && cp -R .next/static .cloudflare-assets/_next/static && npx wrangler deploy",
    "db:init:d1": "wrangler d1 execute thai-3d-studio-db --local --file=./schema.sql",
    "db:deploy:d1": "wrangler d1 execute thai-3d-studio-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.173.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.0"
  }
}
